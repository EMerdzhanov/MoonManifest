  "wisdom4": "\u041d\u0435 \u043f\u0440\u0438\u0432\u043b\u0438\u0447\u0430\u0448 \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u0438\u0441\u043a\u0430\u0448. \u041f\u0440\u0438\u0432\u043b\u0438\u0447\u0430\u0448 \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u0441\u0438.",
  "wisdom5": "\u041a\u043e\u0433\u0430\u0442\u043e \u043f\u0443\u0441\u043d\u0430 \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u0441\u044a\u043c, \u0441\u0442\u0430\u0432\u0430\u043c \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u043c\u043e\u0433\u0430 \u0434\u0430 \u0431\u044a\u0434\u0430.",
  "wisdom5Author": "\u041b\u0430\u043e \u0426\u0437\u044a",
  "wisdom6": "\u041f\u0440\u0438\u0440\u043e\u0434\u0430\u0442\u0430 \u043d\u0435 \u0431\u044a\u0440\u0437\u0430, \u043d\u043e \u0432\u0441\u0438\u0447\u043a\u043e \u0435 \u043f\u043e\u0441\u0442\u0438\u0433\u043d\u0430\u0442\u043e.",
  "wisdom6Author": "\u041b\u0430\u043e \u0426\u0437\u044a",
  "wisdom7": "\u041f\u0440\u0438\u0435\u043c\u0438 \u0443\u0441\u0435\u0449\u0430\u043d\u0435\u0442\u043e \u043d\u0430 \u0438\u0437\u043f\u044a\u043b\u043d\u0435\u043d\u043e\u0442\u043e \u0441\u0438 \u0436\u0435\u043b\u0430\u043d\u0438\u0435 \u0438 \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0432\u0430\u0439 \u043f\u044a\u0442\u044f, \u043a\u043e\u0439\u0442\u043e \u0432\u043d\u0438\u043c\u0430\u043d\u0438\u0435\u0442\u043e \u0442\u0438 \u0441\u043b\u0435\u0434\u0432\u0430.",
  "wisdom7Author": "\u041d\u0435\u0432\u0438\u043b \u0413\u043e\u0434\u0430\u0440\u0434",
  "wisdom8": "\u041d\u0430\u0439-\u0433\u043e\u043b\u044f\u043c\u0430\u0442\u0430 \u0437\u0430\u0431\u043b\u0443\u0434\u0430 \u043d\u0430 \u0447\u043e\u0432\u0435\u043a\u0430 \u0435 \u0443\u0431\u0435\u0436\u0434\u0435\u043d\u0438\u0435\u0442\u043e \u043c\u0443, \u0447\u0435 \u0441\u044a\u0449\u0435\u0441\u0442\u0432\u0443\u0432\u0430\u0442 \u043f\u0440\u0438\u0447\u0438\u043d\u0438 \u0438\u0437\u0432\u044a\u043d \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043e\u0442\u043e \u043c\u0443 \u0441\u044a\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u043d\u0430 \u0441\u044a\u0437\u043d\u0430\u043d\u0438\u0435\u0442\u043e.",
  "wisdom8Author": "\u041d\u0435\u0432\u0438\u043b \u0413\u043e\u0434\u0430\u0440\u0434",
  "wisdom9": "\u0412\u0438\u043d\u0430\u0433\u0438 \u0441\u0438 \u0443\u0447\u0435\u043d\u0438\u043a, \u043d\u0438\u043a\u043e\u0433\u0430 \u043c\u0430\u0439\u0441\u0442\u043e\u0440. \u0422\u0440\u044f\u0431\u0432\u0430 \u0434\u0430 \u043f\u0440\u043e\u0434\u044a\u043b\u0436\u0430\u0432\u0430\u0448 \u043d\u0430\u043f\u0440\u0435\u0434.",
  "wisdom9Author": "\u041a\u043e\u043d\u0440\u0430\u0434 \u0425\u043e\u043b",
  "wisdom10": "\u0421\u043f\u0440\u0438 \u0434\u0430 \u0441\u0435 \u0434\u044a\u0440\u0436\u0438\u0448 \u0442\u0430\u043a\u0430 \u0434\u0440\u0435\u0431\u043d\u043e. \u0422\u0438 \u0441\u0438 \u0432\u0441\u0435\u043b\u0435\u043d\u0430\u0442\u0430 \u0432 \u0435\u043a\u0441\u0442\u0430\u0442\u0438\u0447\u043d\u043e \u0434\u0432\u0438\u0436\u0435\u043d\u0438\u0435.",
  "wisdom10Author": "\u0420\u0443\u043c\u0438",
  "wisdom11": "\u041d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u044f\u0442 \u043c\u043e\u043c\u0435\u043d\u0442 \u0432\u0438\u043d\u0430\u0433\u0438 \u0449\u0435 \u0435 \u0431\u0438\u043b. \u041f\u043e\u0447\u0438\u0432\u0430\u0439 \u0432 \u0442\u043e\u0432\u0430.",
  "wisdom12": "\u041e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0438 \u0434\u0430\u0432\u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u0430, \u0430 \u0441\u0432\u043e\u0431\u043e\u0434\u0430\u0442\u0430 \u0435 \u0435\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u043e\u0442\u043e \u0443\u0441\u043b\u043e\u0432\u0438\u0435 \u0437\u0430 \u0449\u0430\u0441\u0442\u0438\u0435.",
  "wisdom12Author": "\u0422\u0438\u0447 \u041d\u044f\u0442 \u0425\u0430\u043d",
  "wisdom13": "\u041f\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u0435\u0442\u043e \u043d\u0435 \u0435 \u043e\u0442\u043a\u0430\u0437\u0432\u0430\u043d\u0435. \u0422\u043e \u0435 \u043e\u0442\u0434\u0430\u0432\u0430\u043d\u0435 \u043d\u0430 \u043d\u0435\u0449\u043e \u043f\u043e-\u0433\u043e\u043b\u044f\u043c\u043e.",
  "wisdom14": "\u0412 \u0442\u043e\u0437\u0438 \u043c\u043e\u043c\u0435\u043d\u0442 \u043d\u043e\u0441\u0438\u0448 \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438 \u0432\u0441\u0438\u0447\u043a\u043e \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e, \u0437\u0430 \u0434\u0430 \u0441\u0435 \u0441\u043f\u0440\u0430\u0432\u0438\u0448 \u0441 \u0432\u0441\u0438\u0447\u043a\u043e, \u043a\u043e\u0435\u0442\u043e \u0441\u0432\u0435\u0442\u044a\u0442 \u043c\u043e\u0436\u0435 \u0434\u0430 \u0442\u0438 \u043f\u043e\u0434\u0445\u0432\u044a\u0440\u043b\u0438.",
  "wisdom14Author": "\u0411\u0440\u0430\u0439\u044a\u043d \u0422\u0440\u0435\u0439\u0441\u0438",
  "wisdom15": "\u041a\u043e\u043b\u043a\u043e\u0442\u043e \u043f\u043e-\u0442\u0438\u0445 \u0441\u0442\u0430\u0432\u0430\u0448, \u0442\u043e\u043b\u043a\u043e\u0432\u0430 \u043f\u043e\u0432\u0435\u0447\u0435 \u043c\u043e\u0436\u0435\u0448 \u0434\u0430 \u0447\u0443\u0435\u0448.",
  "wisdom15Author": "\u0420\u0443\u043c\u0438",
  "wisdom16": "\u0422\u0432\u043e\u044f\u0442\u0430 \u0437\u0430\u0434\u0430\u0447\u0430 \u043d\u0435 \u0435 \u0434\u0430 \u0442\u044a\u0440\u0441\u0438\u0448 \u043b\u044e\u0431\u043e\u0432, \u0430 \u043f\u0440\u043e\u0441\u0442\u043e \u0434\u0430 \u0442\u044a\u0440\u0441\u0438\u0448 \u0438 \u043d\u0430\u043c\u0435\u0440\u0438\u0448 \u0432\u0441\u0438\u0447\u043a\u0438 \u043f\u0440\u0435\u0433\u0440\u0430\u0434\u0438 \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438, \u043a\u043e\u0438\u0442\u043e \u0441\u0438 \u0438\u0437\u0433\u0440\u0430\u0434\u0438\u043b \u0441\u0440\u0435\u0449\u0443 \u043d\u0435\u044f.",
  "wisdom16Author": "\u0420\u0443\u043c\u0438",
  "wisdom17": "\u0412\u044f\u0440\u0430\u0442\u0430 \u0435 \u0434\u0430 \u043d\u0430\u043f\u0440\u0430\u0432\u0438\u0448 \u043f\u044a\u0440\u0432\u0430\u0442\u0430 \u043a\u0440\u0430\u0447\u043a\u0430, \u0434\u043e\u0440\u0438 \u043a\u043e\u0433\u0430\u0442\u043e \u043d\u0435 \u0432\u0438\u0436\u0434\u0430\u0448 \u0446\u044f\u043b\u043e\u0442\u043e \u0441\u0442\u044a\u043b\u0431\u0438\u0449\u0435.",
  "wisdom17Author": "\u041c\u0430\u0440\u0442\u0438\u043d \u041b\u0443\u0442\u044a\u0440 \u041a\u0438\u043d\u0433 \u041c\u043b.",
  "wisdom18": "\u0421\u0435\u043c\u0435\u0442\u043e \u043d\u0435 \u0441\u0435 \u0431\u043e\u0440\u0438 \u0441 \u043f\u043e\u0447\u0432\u0430\u0442\u0430. \u041f\u0440\u043e\u0441\u0442\u043e \u0440\u0430\u0441\u0442\u0435.",
  "wisdom19": "\u041e\u0441\u0432\u043e\u0431\u043e\u0434\u0438 \u043d\u0443\u0436\u0434\u0430\u0442\u0430 \u0434\u0430 \u0437\u043d\u0430\u0435\u0448 \u043a\u0430\u043a. \u0414\u043e\u0432\u0435\u0440\u0438 \u0441\u0435, \u0447\u0435 \u0432\u0441\u0435\u043b\u0435\u043d\u0430\u0442\u0430 \u0437\u043d\u0430\u0435 \u043f\u044a\u0442\u044f.",
  "wisdom20": "\u0417\u0430\u043f\u043e\u0447\u043d\u0438 \u0434\u0430 \u0441\u0435 \u0432\u0438\u0436\u0434\u0430\u0448 \u043a\u0430\u0442\u043e \u0434\u0443\u0448\u0430 \u0441 \u0442\u044f\u043b\u043e, \u0430 \u043d\u0435 \u043a\u0430\u0442\u043e \u0442\u044f\u043b\u043e \u0441 \u0434\u0443\u0448\u0430.",
  "wisdom20Author": "\u0423\u0435\u0439\u043d \u0414\u0430\u0439\u044a\u0440",
  "wisdom21": "\u041d\u0435 \u043c\u043e\u0436\u0435\u0448 \u0432\u0438\u043d\u0430\u0433\u0438 \u0434\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0430\u0448 \u0441\u043b\u0443\u0447\u0432\u0430\u0449\u043e\u0442\u043e \u0441\u0435 \u043e\u0442\u0432\u044a\u043d. \u041d\u043e \u0432\u0438\u043d\u0430\u0433\u0438 \u043c\u043e\u0436\u0435\u0448 \u0434\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u0438\u0440\u0430\u0448 \u0441\u043b\u0443\u0447\u0432\u0430\u0449\u043e\u0442\u043e \u0441\u0435 \u0432\u044a\u0442\u0440\u0435.",
  "wisdom21Author": "\u0423\u0435\u0439\u043d \u0414\u0430\u0439\u044a\u0440",
  "wisdom22": "\u0422\u044a\u0440\u043f\u0435\u043d\u0438\u0435\u0442\u043e \u043d\u0435 \u0435 \u043f\u0430\u0441\u0438\u0432\u043d\u043e \u0447\u0430\u043a\u0430\u043d\u0435. \u0422\u043e \u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e \u0434\u043e\u0432\u0435\u0440\u0438\u0435.",
  "wisdom23": "\u0412\u0441\u0438\u0447\u043a\u043e, \u043e\u0442 \u043a\u043e\u0435\u0442\u043e \u0438\u043c\u0430\u0448 \u043d\u0443\u0436\u0434\u0430, \u0432\u0435\u0447\u0435 \u0435 \u0432 \u0442\u0435\u0431, \u0447\u0430\u043a\u0430\u0449\u043e \u0434\u0430 \u0441\u0435 \u0440\u0430\u0437\u0433\u044a\u0440\u043d\u0435.",
  "wisdom24": "\u041b\u0443\u043d\u0430\u0442\u0430 \u043d\u0435 \u0441\u0435 \u0431\u043e\u0440\u0438. \u0422\u044f \u043d\u0430\u0431\u043b\u044e\u0434\u0430\u0432\u0430. \u0418 \u0447\u0440\u0435\u0437 \u043d\u0430\u0431\u043b\u044e\u0434\u0435\u043d\u0438\u0435\u0442\u043e \u0434\u044a\u0440\u0436\u0438 \u0432\u0441\u0438\u0447\u043a\u043e \u0437\u0430\u0435\u0434\u043d\u043e.",
  "wisdom25": "\u0414\u0435\u0439\u0441\u0442\u0432\u0430\u0439 \u0442\u0430\u043a\u0430, \u0441\u044f\u043a\u0430\u0448 \u0442\u043e\u0432\u0430, \u043a\u043e\u0435\u0442\u043e \u0438\u0441\u043a\u0430\u0448 \u0434\u0430 \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0438\u0440\u0430\u0448 \u0432 \u0436\u0438\u0432\u043e\u0442\u0430 \u0441\u0438, \u0432\u0435\u0447\u0435 \u0435 \u0440\u0435\u0430\u043b\u043d\u043e\u0441\u0442.",
  "wisdom25Author": "\u0423\u0435\u0439\u043d \u0414\u0430\u0439\u044a\u0440",
  "wisdom26": "\u0411\u044a\u0434\u0438 \u0442\u0438\u0445 \u0438 \u0437\u043d\u0430\u0439.",
  "wisdom27": "\u041f\u0443\u0441\u043d\u0438 \u043a\u043b\u043e\u043d\u0438\u0442\u0435 \u0438 \u0441\u0435 \u0434\u043e\u0432\u0435\u0440\u0438 \u043d\u0430 \u0440\u0435\u043a\u0430\u0442\u0430.",
  "wisdom28": "\u0420\u0430\u043d\u0430\u0442\u0430 \u0435 \u043c\u044f\u0441\u0442\u043e\u0442\u043e, \u043e\u0442\u043a\u044a\u0434\u0435\u0442\u043e \u0441\u0432\u0435\u0442\u043b\u0438\u043d\u0430\u0442\u0430 \u043d\u0430\u0432\u043b\u0438\u0437\u0430 \u0432 \u0442\u0435\u0431.",
  "wisdom28Author": "\u0420\u0443\u043c\u0438",
  "wisdom29": "\u041a\u043e\u0440\u0430\u0431\u044a\u0442 \u0432 \u043f\u0440\u0438\u0441\u0442\u0430\u043d\u0438\u0449\u0435\u0442\u043e \u0435 \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442, \u043d\u043e \u043d\u0435 \u0437\u0430 \u0442\u043e\u0432\u0430 \u0441\u0430 \u0441\u044a\u0437\u0434\u0430\u0434\u0435\u043d\u0438 \u043a\u043e\u0440\u0430\u0431\u0438\u0442\u0435.",
  "wisdom29Author": "\u0414\u0436\u043e\u043d \u0410. \u0428\u0435\u0434",
  "wisdom30": "\u0412\u0441\u0435\u043b\u0435\u043d\u0430\u0442\u0430 \u0432\u0438\u043d\u0430\u0433\u0438 \u043d\u0438 \u0433\u043e\u0432\u043e\u0440\u0438. \u0418\u0437\u043f\u0440\u0430\u0449\u0430 \u043d\u0438 \u043c\u0430\u043b\u043a\u0438 \u043f\u043e\u0441\u043b\u0430\u043d\u0438\u044f, \u043f\u0440\u0435\u0434\u0438\u0437\u0432\u0438\u043a\u0432\u0430 \u0441\u044a\u0432\u043f\u0430\u0434\u0435\u043d\u0438\u044f \u0438 \u0449\u0430\u0441\u0442\u043b\u0438\u0432\u0438 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0441\u0442\u0438. \u0415\u0434\u0438\u043d\u0441\u0442\u0432\u0435\u043d\u0438\u044f\u0442 \u0432\u044a\u043f\u0440\u043e\u0441 \u0435: \u0441\u043b\u0443\u0448\u0430\u043c\u0435 \u043b\u0438?",
  "wisdom30Author": "\u041d\u0430\u043d\u0441\u0438 \u0422\u0435\u0439\u044a\u0440"
}