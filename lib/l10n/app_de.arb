  "wisdom1": "Was du suchst, sucht auch dich.",
  "wisdom1Author": "Rumi",
  "wisdom2": "Das Universum ist nicht außerhalb von dir. Schau in dich hinein; alles, was du willst, bist du bereits.",
  "wisdom2Author": "Rumi",
  "wisdom3": "Vertraue dem Warten. Umarme die Ungewissheit.",
  "wisdom4": "Du ziehst nicht an, was du willst. Du ziehst an, was du bist.",
  "wisdom5": "Wenn ich loslasse, was ich bin, werde ich, was ich sein könnte.",
  "wisdom5Author": "Lao Tzu",
  "wisdom6": "Die Natur eilt nicht, und doch ist alles vollbracht.",
  "wisdom6Author": "Lao Tzu",
  "wisdom7": "Nimm das Gefühl deines erfüllten Wunsches an und beobachte den Weg, den deine Aufmerksamkeit nimmt.",
  "wisdom7Author": "Neville Goddard",
  "wisdom8": "Die größte Täuschung des Menschen ist seine Überzeugung, dass es Ursachen außerhalb seines eigenen Bewusstseinszustandes gibt.",
  "wisdom8Author": "Neville Goddard",
  "wisdom9": "Du bist immer Schüler, nie Meister. Du musst immer weiter vorangehen.",
  "wisdom9Author": "Conrad Hall",
  "wisdom10": "Hör auf, dich so klein zu verhalten. Du bist das Universum in ekstatischer Bewegung.",
  "wisdom10Author": "Rumi",
  "wisdom11": "Der gegenwärtige Moment wird immer gewesen sein. Ruhe darin.",
  "wisdom12": "Loslassen gibt uns Freiheit, und Freiheit ist die einzige Voraussetzung für Glück.",
  "wisdom12Author": "Thich Nhat Hanh",
  "wisdom13": "Sich ergeben heißt nicht aufzugeben. Es heißt, sich etwas Größerem hinzugeben.",
  "wisdom14": "Du hast gerade jetzt alles in dir, was du brauchst, um mit allem umzugehen, was die Welt dir entgegenwerfen kann.",
  "wisdom14Author": "Brian Tracy",
  "wisdom15": "Je stiller du wirst, desto mehr kannst du hören.",
  "wisdom15Author": "Rumi",
  "wisdom16": "Deine Aufgabe ist es nicht, nach Liebe zu suchen, sondern alle Barrieren in dir zu finden, die du gegen sie errichtet hast.",
  "wisdom16Author": "Rumi",
  "wisdom17": "Glaube bedeutet, den ersten Schritt zu tun, auch wenn du die ganze Treppe nicht siehst.",
  "wisdom17Author": "Martin Luther King Jr.",
  "wisdom18": "Der Same kämpft nicht gegen die Erde. Er wächst einfach.",
  "wisdom19": "Lass das Bedürfnis los zu wissen, wie. Vertraue darauf, dass das Universum den Weg kennt.",
  "wisdom20": "Beginne, dich als Seele mit einem Körper zu sehen, statt als Körper mit einer Seele.",
  "wisdom20Author": "Wayne Dyer",
  "wisdom21": "Du kannst nicht immer kontrollieren, was draußen passiert. Aber du kannst immer kontrollieren, was drinnen passiert.",
  "wisdom21Author": "Wayne Dyer",
  "wisdom22": "Geduld ist kein passives Warten. Sie ist aktives Vertrauen.",
  "wisdom23": "Alles, was du brauchst, ist bereits in dir und wartet darauf, sich zu entfalten.",
  "wisdom24": "Der Mond kämpft nicht. Er beobachtet. Und durch das Beobachten hält er alles zusammen.",
  "wisdom25": "Handle so, als wäre das, was du in deinem Leben manifestieren willst, bereits Wirklichkeit.",
  "wisdom25Author": "Wayne Dyer",
  "wisdom26": "Sei still und wisse.",
  "wisdom27": "Lass die Äste los und vertraue dem Fluss.",
  "wisdom28": "Die Wunde ist der Ort, an dem das Licht in dich eintritt.",
  "wisdom28Author": "Rumi",
  "wisdom29": "Ein Schiff im Hafen ist sicher, aber dafür werden Schiffe nicht gebaut.",
  "wisdom29Author": "John A. Shedd",
  "wisdom30": "Das Universum spricht immer zu uns. Es sendet uns kleine Botschaften, verursacht Zufälle und glückliche Fügungen. Die einzige Frage ist: Hören wir zu?",
  "wisdom30Author": "Nancy Thayer"
}
