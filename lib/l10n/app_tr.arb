  "wisdom1": "Aradığın şey seni arıyor.",
  "wisdom1Author": "Mevlana",
  "wisdom2": "Evren senin dışında değil. Kendine bak; istediğin her şey zaten sensin.",
  "wisdom2Author": "Mevlana",
  "wisdom3": "Bekleyişe güven. Belirsizliği kucakla.",
  "wisdom4": "İstediğin şeyi çekmezsin. Olduğun şeyi çekersin.",
  "wisdom5": "Olduğum şeyi bıraktığımda, olabileceğim şey olurum.",
  "wisdom5Author": "Lao Tzu",
  "wisdom6": "Doğa acele etmez, yine de her şey tamamlanır.",
  "wisdom6Author": "Lao Tzu",
  "wisdom7": "Dileğinin gerçekleşmiş hissini yaşa ve dikkatinin izlediği yolu gözlemle.",
  "wisdom7Author": "Neville Goddard",
  "wisdom8": "İnsanın en büyük yanılgısı, kendi bilinç durumu dışında başka sebepler olduğuna olan inancıdır.",
  "wisdom8Author": "Neville Goddard",
  "wisdom9": "Her zaman öğrencisiniz, asla usta değil. İlerlemeye devam etmelisiniz.",
  "wisdom9Author": "Conrad Hall",
  "wisdom10": "Bu kadar küçük davranmayı bırak. Sen coşkuyla hareket eden evrensin.",
  "wisdom10Author": "Mevlana",
  "wisdom11": "Şimdiki an her zaman var olmuş olacak. Bunda huzur bul.",
  "wisdom12": "Bırakmak bize özgürlük verir ve özgürlük mutluluğun tek koşuludur.",
  "wisdom12Author": "Thich Nhat Hanh",
  "wisdom13": "Teslim olmak vazgeçmek değildir. Daha büyük bir şeye bırakmaktır.",
  "wisdom14": "Şu anda içinde, dünyanın sana ne fırlatırsa fırlatsın başa çıkman için gereken her şey var.",
  "wisdom14Author": "Brian Tracy",
  "wisdom15": "Ne kadar sessizleşirsen, o kadar çok duyabilirsin.",
  "wisdom15Author": "Mevlana",
  "wisdom16": "Görevin sevgiyi aramak değil, sadece sevgiye karşı kendi içinde kurduğun tüm engelleri bulmak ve kaldırmaktır.",
  "wisdom16Author": "Mevlana",
  "wisdom17": "İnanç, tüm merdiveni görmesen bile ilk adımı atmaktır.",
  "wisdom17Author": "Martin Luther King Jr.",
  "wisdom18": "Tohum toprakla savaşmaz. Sadece büyür.",
  "wisdom19": "Nasıl olacağını bilme ihtiyacını bırak. Evrenin yolu bildiğine güven.",
  "wisdom20": "Kendinizi ruhu olan bir beden olarak değil, bedeni olan bir ruh olarak görmeye başlayın.",
  "wisdom20Author": "Wayne Dyer",
  "wisdom21": "Dışarıda olup biteni her zaman kontrol edemezsiniz. Ama içeride olup biteni her zaman kontrol edebilirsiniz.",
  "wisdom21Author": "Wayne Dyer",
  "wisdom22": "Sabır pasif bekleyiş değildir. Aktif güvendir.",
  "wisdom23": "İhtiyacın olan her şey zaten içinde, açılmayı bekliyor.",
  "wisdom24": "Ay savaşmaz. İzler. Ve izleyerek her şeyi bir arada tutar.",
  "wisdom25": "Hayatınızda gerçekleştirmek istediğiniz şey zaten bir gerçekmiş gibi davranın.",
  "wisdom25Author": "Wayne Dyer",
  "wisdom26": "Sessiz ol ve bil.",
  "wisdom27": "Dalları bırak ve nehre güven.",
  "wisdom28": "Yara, ışığın sana girdiği yerdir.",
  "wisdom28Author": "Mevlana",
  "wisdom29": "Limandaki gemi güvendedir, ama gemiler bunun için yapılmamıştır.",
  "wisdom29Author": "John A. Shedd",
  "wisdom30": "Evren her zaman bizimle konuşuyor. Bize küçük mesajlar gönderiyor, tesadüfler ve rastlantılar yaratıyor. Tek soru şu: dinliyor muyuz?",
  "wisdom30Author": "Nancy Thayer"
}