  "wisdom1": "你所寻找的，也在寻找你。",
  "wisdom1Author": "鲁米",
  "wisdom2": "宇宙不在你身外。向内看，你想要的一切，你已经是了。",
  "wisdom2Author": "鲁米",
  "wisdom3": "信任等待。拥抱不确定。",
  "wisdom4": "你吸引的不是你想要的，而是你所是的。",
  "wisdom5": "当我放下我是什么，我就成为我可能是的。",
  "wisdom5Author": "老子",
  "wisdom6": "天地不争，万物自成。",
  "wisdom6Author": "老子",
  "wisdom7": "假定你的愿望已经实现的感觉，然后观察你注意力所遵循的路线。",
  "wisdom7Author": "内维尔·戈达德",
  "wisdom8": "人最大的错觉，是以为存在他自身意识状态之外的原因。",
  "wisdom8Author": "内维尔·戈达德",
  "wisdom9": "你永远是学生，从不是大师。你必须持续前行。",
  "wisdom9Author": "康拉德·霍尔",
  "wisdom10": "别再把自己看得那么渺小。你是宇宙在欣喜地舞动。",
  "wisdom10Author": "鲁米",
  "wisdom11": "此刻永恒存在。安住于此。",
  "wisdom12": "放下给予我们自由，而自由是幸福的唯一条件。",
  "wisdom12Author": "一行禅师",
  "wisdom13": "臣服不是放弃。是将自己交托给更伟大的存在。",
  "wisdom14": "此刻的你，已经拥有应对世间一切的力量。",
  "wisdom14Author": "博恩·崔西",
  "wisdom15": "你越安静，就越能听见。",
  "wisdom15Author": "鲁米",
  "wisdom16": "你的任务不是去寻找爱，而是去发现你内心为抵御爱而筑起的所有屏障。",
  "wisdom16Author": "鲁米",
  "wisdom17": "信念是在看不到整个阶梯时迈出第一步。",
  "wisdom17Author": "马丁·路德·金",
  "wisdom18": "种子不与泥土对抗。它只是生长。",
  "wisdom19": "放下对「如何」的执念。相信宇宙知道方向。",
  "wisdom20": "开始把自己看作拥有身体的灵魂，而不是拥有灵魂的身体。",
  "wisdom20Author": "韦恩·戴尔",
  "wisdom21": "你不能总是控制外在发生的事。但你始终可以控制内在发生的事。",
  "wisdom21Author": "韦恩·戴尔",
  "wisdom22": "耐心不是被动的等待。它是主动的信任。",
  "wisdom23": "你所需要的一切已在你之内，等待绽放。",
  "wisdom24": "月亮不争。它注视。在注视中，它将一切凝聚在一起。",
  "wisdom25": "行动起来，如同你想在生命中显化的已是现实。",
  "wisdom25Author": "韦恩·戴尔",
  "wisdom26": "静下来，去感知。",
  "wisdom27": "放开枝干，信任河流。",
  "wisdom28": "伤口，是光进入你的地方。",
  "wisdom28Author": "鲁米",
  "wisdom29": "停在港湾里的船是安全的，但那不是造船的目的。",
  "wisdom29Author": "约翰·A·谢德",
  "wisdom30": "宇宙一直在对我们说话。给我们送来小小的讯息，制造巧合与缘分。唯一的问题是：我们在听吗？",
  "wisdom30Author": "南希·塞耶"
}
